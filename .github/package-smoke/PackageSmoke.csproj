<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Inkwright" Version="$(InkwrightPackageVersion)" />
    <PackageReference Include="Inkwright.Cjk" Version="$(InkwrightPackageVersion)" />
    <PackageReference Include="Inkwright.Forms" Version="$(InkwrightPackageVersion)" />
    <PackageReference Include="Inkwright.Layout" Version="$(InkwrightPackageVersion)" />
    <PackageReference Include="Inkwright.Signing" Version="$(InkwrightPackageVersion)" />
  </ItemGroup>

</Project>
